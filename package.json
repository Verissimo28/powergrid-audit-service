{
  "name": "@powergrid/audit-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/unit/*.test.ts",
    "lint": "echo 'lint do audit-service ser\u00e1 configurado na etapa de qualidade'",
    "db:migrate": "psql \"$AUDIT_DATABASE_URL\" -f src/database/migrations/001_initial.sql"
  },
  "dependencies": {
    "amqplib": "^2.4.0",
    "dotenv": "16.4.7",
    "fastify": "5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
